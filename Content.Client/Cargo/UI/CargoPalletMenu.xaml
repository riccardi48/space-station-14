<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'cargo-pallet-console-menu-title'}"
    MinSize="300 150"
    SetSize="300 150">
    <BoxContainer Margin="5" Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <Label StyleClasses="LabelKeyText" Text="{Loc 'cargo-pallet-menu-appraisal-label'}" />
            <Label Name="AppraisalLabel" Text="{Loc 'cargo-pallet-menu-no-goods-text'}" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label StyleClasses="LabelKeyText" Text="{Loc 'cargo-pallet-menu-count-label'}" />
            <Label Name="CountLabel" Text="{Loc 'cargo-pallet-menu-no-goods-text'}" />
        </BoxContainer>
        <Button Name="AppraiseButton" Text="{Loc 'cargo-pallet-appraise-button'}" />
        <Button Name="SellButton" Text="{Loc 'cargo-pallet-sell-button'}" />
        <TextureButton VerticalExpand="True" />
    </BoxContainer>
</controls:FancyWindow>
