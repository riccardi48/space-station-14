<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc 'bounty-console-menu-title'}"
    MinSize="400 350"
    SetSize="550 420">
    <BoxContainer
        HorizontalExpand="True"
        Orientation="Vertical"
        VerticalExpand="True">
        <PanelContainer
            Margin="10"
            HorizontalExpand="True"
            VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <TabContainer
                Name="MasterTabContainer"
                HorizontalExpand="True"
                VerticalExpand="True">
                <ScrollContainer
                    HScrollEnabled="False"
                    HorizontalExpand="True"
                    VerticalExpand="True">
                    <BoxContainer
                        Name="BountyEntriesContainer"
                        HorizontalExpand="True"
                        Orientation="Vertical"
                        VerticalExpand="True" />
                </ScrollContainer>
                <ScrollContainer
                    HScrollEnabled="False"
                    HorizontalExpand="True"
                    VerticalExpand="True">
                    <Label
                        Name="NoHistoryLabel"
                        Align="Center"
                        Text="{Loc 'bounty-console-history-empty-label'}"
                        Visible="False" />
                    <BoxContainer
                        Name="BountyHistoryContainer"
                        HorizontalExpand="True"
                        Orientation="Vertical"
                        VerticalExpand="True" />
                </ScrollContainer>
            </TabContainer>
        </PanelContainer>
        <!--  Footer  -->
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer
                Margin="10,2,5,0"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <Label StyleClasses="WindowFooterText" Text="{Loc 'bounty-console-flavor-left'}" />
                <Label
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    HorizontalExpand="True"
                    StyleClasses="WindowFooterText"
                    Text="{Loc 'bounty-console-flavor-right'}" />
                <TextureRect
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    SetSize="19 19"
                    Stretch="KeepAspectCentered"
                    StyleClasses="NTLogoDark" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
