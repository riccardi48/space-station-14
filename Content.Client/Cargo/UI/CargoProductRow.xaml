<BoxContainer xmlns="https://spacestation14.io" HorizontalExpand="True">
    <PanelContainer HorizontalExpand="True">
        <!--  Btn position hardcoded (args.Button.Parent?.Parent type) in CargoConsoleBUI 71 line  -->
        <Button
            Name="MainButton"
            Access="Public"
            StyleClasses="OpenBoth"
            ToolTip=""
            VerticalExpand="False" />

        <!--  Icon & Name  -->
        <BoxContainer
            Margin="4,0"
            HorizontalExpand="True"
            Orientation="Horizontal">

            <TextureRect
                Name="Icon"
                Access="Public"
                MinSize="32 32"
                RectClipContent="True" />

            <Label
                Name="ProductName"
                Access="Public"
                ClipText="True"
                HorizontalExpand="True" />
        </BoxContainer>
    </PanelContainer>

    <Label
        Name="PointCost"
        Margin="0,0,5,0"
        HorizontalAlignment="Right"
        Access="Public"
        Align="Right"
        MinSize="56 32" />
</BoxContainer>
